# Development/local overrides. Never put real secrets in this template.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=
DATABASE_URL=
CHAMALINK_ALLOWED_HOSTS=

# Optional email delivery
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
CHAMALINK_SALES_EMAIL=

# Safaricom Daraja production values must be stored as host secrets.
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_CALLBACK_URL=
